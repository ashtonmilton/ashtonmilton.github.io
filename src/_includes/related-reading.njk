{% if relatedReading and relatedReading.length %}
<nav class="article-end" aria-labelledby="related-reading">
  <h2 id="related-reading">Related Reading</h2>
  <ul class="reference-list">
    {% for link in relatedReading %}
    <li><a class="text-link" href="{{ link.url | escape }}">{{ link.label | escape }}</a></li>
    {% endfor %}
  </ul>
</nav>
{% endif %}
