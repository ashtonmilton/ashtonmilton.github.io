{% set titleTag = metaTitle or (title + " | " + site.author) %}
{% set metaDescription = description or site.description %}
{% set canonicalUrl = site.url + page.url %}
{% set socialImage = site.url + (shareImage or site.image) %}
<!DOCTYPE html>
<html lang="{{ pageLanguage or 'en-GB' }}"{% if pageDirection %} dir="{{ pageDirection }}"{% endif %}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ titleTag | escape }}</title>
  <meta name="description" content="{{ metaDescription | escape }}" />
  {% if robots %}<meta name="robots" content="{{ robots }}" />{% elif noindex %}<meta name="robots" content="noindex" />{% endif %}
  <meta name="author" content="{{ site.author }}" />
  {% if analytics.readershipDisabled %}<meta name="readership-edge-fallback" content="off" />{% endif %}
  {% if (analytics.token or analytics.readership) and not noindex %}
  {% if analytics.token %}<meta name="web-analytics-token" content="{{ analytics.token }}" />{% endif %}
  {% if analytics.readership %}<meta name="readership-events" content="on" />{% endif %}
  <link rel="stylesheet" href="/_readership-switch.css" />
  <script defer src="/assets/js/analytics.js?v=5"></script>
  {% endif %}
  <meta name="theme-color" content="{{ site.themeColor }}" />
  <link rel="canonical" href="{{ canonicalUrl }}" />
  {% if navKey == "about" %}
  {% for locale in aboutAlternates %}
  <link rel="alternate" hreflang="{{ locale.lang }}" href="{{ site.url }}{{ locale.url }}" />
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}/about/" />
  {% endif %}
  <meta property="og:type" content="{{ ogType or 'website' }}" />
  <meta property="og:url" content="{{ canonicalUrl }}" />
  <meta property="og:site_name" content="{{ site.name | escape }}" />
  <meta property="og:locale" content="{{ socialLocale or 'en_GB' }}" />
  <meta property="og:title" content="{{ titleTag | escape }}" />
  <meta property="og:description" content="{{ metaDescription | escape }}" />
  <meta property="og:image" content="{{ socialImage }}" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="{{ titleTag | escape }}" />
  <meta name="twitter:description" content="{{ metaDescription | escape }}" />
  <meta name="twitter:image" content="{{ socialImage }}" />
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/favicon.ico" />
  {% if ogType == "article" and category %}
  <meta property="article:section" content="{{ category | escape }}" />
  {% endif %}
  {% if publication %}<meta name="publication:type" content="{{ publication.type | escape }}" />{% endif %}
  {% if date and (page.inputPath | hasFrontMatterDate) and ogType == "article" %}<meta property="article:published_time" content="{{ date | dateToIso }}" />{% elif publication %}<meta property="article:published_time" content="{{ publication.date }}" />{% endif %}
  {% if ogType == "article" and tags %}
  {% for tag in tags %}
  <meta property="article:tag" content="{{ tag | escape }}" />
  {% endfor %}
  {% endif %}
  <link rel="stylesheet" href="/assets/css/site.css?v=2" />
  <link rel="stylesheet" href="/assets/css/publication.css?v=9" />
  {% if preloadHero %}
  <link rel="preload" as="image" href="/assets/images/research-hero.avif" type="image/avif" />
  {% endif %}
  {% if not noindex %}{% include "structured-data.njk" %}{% endif %}
</head>
<body class="publication-dark{% if welcome %} local-edition{% endif %}">
  <a class="skip-link" href="#main" lang="en-GB">Skip to main content</a>
  {% include "nav.njk" %}

  <main id="main">
{{ content | safe }}
  </main>

  {% include "footer.njk" %}
  {% if scripts %}
  {% for script in scripts %}
  <script src="{{ script }}"></script>
  {% endfor %}
  {% endif %}
</body>
</html>
