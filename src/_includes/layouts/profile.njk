{{ content | safe }}
<ul class="wrap about-reading profile-languages" aria-label="Profile languages" lang="en">
{% for locale in aboutLocales %}
  {% if locale.url != page.url %}
  <li><a class="text-link" lang="{{ locale.lang }}" hreflang="{{ locale.lang }}" href="{{ locale.url }}{% if locale.url == '/about/' %}?lang=en{% endif %}">{{ locale.label }}</a></li>
  {% endif %}
{% endfor %}
</ul>
