---
layout: layouts/base.njk
navKey: about
lastmod: "2026-11-27"
---
{% if welcome %}
<header class="welcome-opening">
  <div class="wrap welcome-inner">
    <p class="eyebrow">{{ welcome.eyebrow }}</p>
    <h1 lang="en-GB">{{ site.author }}</h1>
    <p class="welcome-lede">{{ welcome.lede }}</p>
    <a class="text-link welcome-jump" href="#profile">{{ welcome.jump }} <span aria-hidden="true">↓</span></a>
  </div>
</header>
{% endif %}
{{ content | safe }}
{% if welcome %}
<section class="wrap welcome-exit">
  <div><h2>{{ welcome.exitTitle }}</h2>{% if welcome.exitDescription %}<p>{{ welcome.exitDescription }}</p>{% endif %}</div>
  <a class="button" href="/?lang=en" hreflang="en-GB">{{ welcome.exitLink }}</a>
</section>
{% endif %}
