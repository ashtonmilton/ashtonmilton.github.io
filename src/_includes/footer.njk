<footer class="site-footer" lang="en-GB" dir="ltr">
  <div class="wrap footer-inner">
    <div class="footer-meta"><a class="brand" href="/">Ashton Milton</a><span>{{ site.footer }}</span></div>
    <div class="footer-end">
      <nav class="footer-links" aria-label="Footer links">
        <a href="/writing/">Work</a><a href="/research/">Research</a><a href="/policy-analysis/">Policy Analysis</a><a href="/about/">About</a><a href="/contact/">Contact</a>
        {% if publications.length %}<a href="/publications/">Publications</a>{% endif %}
      </nav>
      <small>© 2026 Ashton Milton</small>
      <details class="footer-privacy" id="privacy">
        <summary>Privacy</summary>
        <p>Cloudflare and GitHub process connection data to serve and protect this site. The country of your connection may determine the profile shown on the homepage. Choosing English can be remembered for up to 180 days. <a href="mailto:hello@ashtonmilton.net">Privacy enquiries</a>.</p>
        {% if analytics.token or analytics.readership %}
        <p>Optional analytics measures page views{% if analytics.readership %}, referral sources, clicks and broad search topics, not the words you type{% endif %}{% if analytics.token %}, and site performance{% endif %}. It is off unless you allow it; change your choice here at any time.</p>
        <div id="analytics-preference" hidden>
          <button type="button" data-choice="allow">Allow analytics</button>
          <button type="button" data-choice="off">Turn off analytics</button>
          <p role="status"></p>
        </div>
        {% endif %}
      </details>
    </div>
  </div>
</footer>
