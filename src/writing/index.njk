---
layout: "layouts/base.njk"
permalink: "/writing/"
metaTitle: "Writing & Essays | Ashton Milton"
description: "Independent essays on politics, inequality and public institutions, alongside reflections on urban life and selected academic work."
navKey: "writing"
lastmod: "2026-11-16"
sitemapOrder: 2
scripts: ["/assets/js/archive.js"]
---
<header class="page-masthead">
  <div class="wrap masthead-inner">
    <h1>Writing</h1>
    <p>Independent essays on politics, inequality and public institutions, alongside reflections on urban life and selected academic work.</p>
  </div>
</header>
<div class="wrap archive-layout">
  <div class="archive-tools" role="group" aria-label="Writing categories" hidden>
    <button class="filter-button active" type="button" data-filter="all" aria-pressed="true">All Writing</button>
    <button class="filter-button" type="button" data-filter="Independent work" aria-pressed="false">Independent Work</button>
    <button class="filter-button" type="button" data-filter="Essays &amp; reflections" aria-pressed="false">Essays &amp; Reflections</button>
    <button class="filter-button" type="button" data-filter="Selected academic work" aria-pressed="false">Selected Academic Work</button>
  </div>
  <div class="archive-results">
    {% for category in ["Independent work", "Essays & reflections", "Selected academic work"] %}
    <section class="archive-group" data-archive-group>
      <h2>{% if category == "Independent work" %}Independent Work{% elif category == "Essays & reflections" %}Essays &amp; Reflections{% else %}Selected Academic Work{% endif %}</h2>
      {% if category == "Selected academic work" %}<p class="academic-disclosure">Substantially revised from undergraduate sociology coursework; not peer-reviewed research.</p>{% endif %}
      {% for essay in collections.essays %}{% if essay.data.category == category %}
      <a class="writing-card" href="{{ essay.url }}" data-category="{{ essay.data.category }}">
        <div class="entry-meta"><span>{{ essay.data.readingTime }}</span></div>
        <div class="entry-copy"><h3>{{ essay.data.title }}</h3><p>{{ essay.data.summary }}</p>
          <ul class="tag-row">{% for tag in essay.data.tags %}<li>{{ tag }}</li>{% endfor %}</ul>
        </div>
      </a>
      {% endif %}{% endfor %}
    </section>
    {% endfor %}
    <p class="empty-state" data-empty-state hidden>No pieces are listed in this category yet.</p>
  </div>
</div>
